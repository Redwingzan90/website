  "faqs": [
    {
      "q": "Do I need good credit to buy land?",
      "a": "No! We never check credit. There is no qualifying process and no bank involvement. Owner financing means you deal directly with us."
    },
    {
      "q": "How much do I need to put down?",
      "a": "Down payments start as low as $425. Most properties require $500-$980 down depending on the purchase price."
    },
    {
      "q": "What are the monthly payments?",
      "a": "Monthly payments range from $425 to $980 depending on the property. All terms are clearly listed on each property page."
    },
    {
      "q": "Can I pay off my land early?",
      "a": "Yes! There is no pre-payment penalty on any of our properties. Pay it off as fast as you want."
    },
    {
      "q": "What interest rate do you charge?",
      "a": "Tonopah AZ properties are financed at 12% interest. Texas properties have their own owner financing terms — call for details."
    },
    {
      "q": "Can I build on the land right away?",
      "a": "Yes, most lots are build-ready. Some Tonopah properties are close to electric. Check individual property details for specifics."
    },
    {
      "q": "How do I visit a property in person?",
      "a": "Call our office to schedule an appointment. We can provide pin drops, directions, and arrange a guided tour of any property."
    },
    {
      "q": "What kind of homes can I put on the land?",
      "a": "Single-wide and double-wide mobile homes, barndominiums, cabins, and custom site-built homes are all permitted (some deed restrictions apply on select properties)."
    }
  ],
